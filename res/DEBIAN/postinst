#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/quinyxdesk/quinyxdesk /usr/bin/quinyxdesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/quinyxdesk.service ]; then
			rm /etc/systemd/system/quinyxdesk.service /usr/lib/systemd/system/quinyxdesk.service /usr/lib/systemd/user/quinyxdesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/quinyxdesk/files/systemd/quinyxdesk.service /usr/lib/systemd/system/quinyxdesk.service
		# try fix error in Ubuntu 18.04
		# Failed to reload quinyxdesk.service: Unit quinyxdesk.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/quinyxdesk.service:10: Executable path is not absolute: pkill -f "quinyxdesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/quinyxdesk.service
		fi
		systemctl daemon-reload
		systemctl enable quinyxdesk
		systemctl start quinyxdesk
	fi
fi
